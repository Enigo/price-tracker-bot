#, python-brace-format
msgid ""
"📉 <b>Price drop!</b>\n"
"\n"
"<b>{name}</b>\n"
"<a href=\"{url}\">View product</a>\n"
"\n"
"Was: <s>{old} {symbol}</s>\n"
"Now: <b>{new} {symbol}</b>\n"
"Drop: -{drop} {symbol} ({percent:.1f}%)"
