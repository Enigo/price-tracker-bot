"📉 <b>Prezzo in calo!</b>\n"
"\n"
"<b>{name}</b>\n"
"<a href=\"{url}\">Vedi prodotto</a>\n"
"\n"
"Prima: <s>{old} {symbol}</s>\n"
"Ora: <b>{new} {symbol}</b>\n"
"Calo: -{drop} {symbol} ({percent:.1f}%)"

#: src/price_tracker/core/alert.py:313
#, python-brace-format
msgid ""
"📦 <b>Back in stock!</b>\n"
"\n"
"<b>{name}</b>\n"
"<a href=\"{url}\">View product</a>\n"
"\n"
"Price: <b>{price} {symbol}</b>"
msgstr ""
"📦 <b>Di nuovo disponibile!</b>\n"
"\n"
"<b>{name}</b>\n"
"<a href=\"{url}\">Vedi prodotto</a>\n"
"\n"
"Prezzo: <b>{price} {symbol}</b>"

#: src/price_tracker/core/alert.py:335
#, python-brace-format
msgid ""
"⚠️ <b>Tracking suspended</b>\n"
"\n"
"<b>{name}</b>\n"
"Failed {error_count}/{max_errors} consecutive checks. Use /reactivate to "
"retry."
msgstr ""
"⚠️ <b>Tracciamento sospeso</b>\n"
"\n"
"<b>{name}</b>\n"
"Falliti {error_count}/{max_errors} controlli consecutivi. Usa /riattiva per "
"riprovare."

#: src/price_tracker/core/alert.py:355
#, python-brace-format
msgid ""
"\n"
"🔁 Automatic retry after: {date} UTC"
msgstr ""
"\n"
"🔁 Nuovo tentativo automatico dopo: {date} UTC"

#: src/price_tracker/core/alert.py:359
#, python-brace-format
msgid ""
"🔒 <b>Site automatically paused</b>\n"
"\n"
"<b>{domain}</b> failed too many checks ({reason}).\n"
"Checks for this site are temporarily paused to avoid repeatedly hitting a "
"block.{until}\n"
"\n"
"Details with /errors."
msgstr ""
"🔒 <b>Sito messo automaticamente in pausa</b>\n"
"\n"
"<b>{domain}</b> ha fallito troppi controlli ({reason}).\n"
"I controlli per questo sito sono temporaneamente sospesi per evitare blocchi"
" ripetuti.{until}\n"
"\n"
"Dettagli con /errori."

