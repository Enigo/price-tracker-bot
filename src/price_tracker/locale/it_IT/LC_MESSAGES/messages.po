#, python-brace-format
msgid "Listings removed on {domain}"
msgstr "Prodotti rimossi da {domain}"

msgid "These pages answer HTTP 404/410: the store took them off the catalog."
msgstr "Le pagine rispondono HTTP 404/410: lo store li ha tolti dal catalogo."

msgid "Deleting keeps your list clean. Reactivate only if the store restores them."
msgstr ""
"Eliminarli tiene pulita la lista. Riattivali solo se lo store li rimette in "
"vendita."

#, python-brace-format
msgid "Price unreadable on {domain}"
msgstr "Prezzo illeggibile su {domain}"

msgid ""
"The pages load, but the price could not be read anymore (layout change or a "
"different offer)."
msgstr ""
"Le pagine si aprono, ma il prezzo non si legge più (layout cambiato o "
"offerta diversa)."

msgid "Reactivate to run a fresh check right now."
msgstr "Riattiva per fare subito un nuovo controllo."

#, python-brace-format
msgid "Site unreachable: {domain}"
msgstr "Sito irraggiungibile: {domain}"

#, python-brace-format
msgid "The site did not answer {max} checks in a row."
msgstr "Il sito non ha risposto a {max} controlli di fila."

msgid "Try again later. Reactivate once the site is back."
msgstr "Riprova più tardi. Riattiva quando il sito torna raggiungibile."

#, python-brace-format
msgid "Blocked by {domain}"
msgstr "Bloccato da {domain}"

msgid "The site is refusing automated checks (anti-bot)."
msgstr "Il sito rifiuta i controlli automatici (anti-bot)."

msgid "Domain quarantine already paces retries. Reactivate once it clears."
msgstr ""
"La quarantena del dominio gestisce già i tentativi. Riattiva quando si "
"sblocca."

#, python-brace-format
msgid "Tracking suspended on {domain}"
msgstr "Tracking sospeso su {domain}"

msgid "Checks kept failing."
msgstr "I controlli continuano a fallire."

msgid "Reactivate to retry."
msgstr "Riattiva per riprovare."

